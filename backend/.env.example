# Set DEBUG=False in production
DEBUG=True
SECRET_KEY=your-secret-key

# Database
DB_NAME=dora
DB_USER=dora
DB_PASSWORD=dora
DB_HOST=dora_db
DB_PORT=5432

# Redis
REDIS_CONN_STR=redis://dora_redis:6379
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_CHANNELS_DB=2
REDIS_CHUNKS_DB=3
REDIS_WEBCHUNKS_DB=4

#  Required: OpenAI API - Main model
OPENAI_API_MODEL=gpt-4.1
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_API_TIMEOUT=180
# Options: openai, azure
OPENAI_API_TYPE=openai
# Leave empty for OpenAI official API
OPENAI_API_BASE_URL=
# Required for Azure OpenAI
OPENAI_API_VERSION=
OPENAI_API_DEPLOYMENT_NAME=

# Optional: OpenAI API - Backup model
BACKUP_OPENAI_API_MODEL=gpt-4.1
BACKUP_OPENAI_API_KEY=
BACKUP_OPENAI_API_TYPE=openai
BACKUP_OPENAI_API_BASE_URL=
BACKUP_OPENAI_API_VERSION=
BACKUP_OPENAI_API_DEPLOYMENT_NAME=

# Optional: OpenAI API - Mini model for cost optimization
MINI_OPENAI_API_MODEL=gpt-4.1-mini
MINI_OPENAI_API_KEY=
MINI_OPENAI_API_TYPE=openai
MINI_OPENAI_API_BASE_URL=
MINI_OPENAI_API_VERSION=
MINI_OPENAI_API_DEPLOYMENT_NAME=

# Optional: OpenAI API - Backup Mini model
BACKUP_MINI_OPENAI_API_MODEL=gpt-4.1-mini
BACKUP_MINI_OPENAI_API_KEY=
BACKUP_MINI_OPENAI_API_TYPE=openai
BACKUP_MINI_OPENAI_API_BASE_URL=
BACKUP_MINI_OPENAI_API_VERSION=
BACKUP_MINI_OPENAI_API_DEPLOYMENT_NAME=

# Required: OpenAI API - Embedding model
# Required for web search and custom bibliography features
EMBEDDING_OPENAI_API_CONFIGS=[{"model": "text-embedding-3-small", "api_key": "<your_openai_api_key>", "base_url": "", "version": "", "deployment_name": ""}]

# Generation settings
# Number of retries on failure
GENERATION_RETRY_TIMES=1

# Tool and agent settings
TOOL_EXECUTION_COUNT_LIMIT=False
TOOL_MAX_EXECUTION_COUNT=20
AGENT_EXECUTOR_MAX_ITERATIONS=30

# Application settings
DORA_PUBLIC_URL=http://localhost
DORA_STATIC_URL=http://localhost
# Task timeout in seconds
GENERATION_TASK_TIMEOUT=3600
CSRF_TRUSTED_ORIGINS=http://localhost:80

# External services
MERMAID_SERVER_URL=https://mermaid.ink
# Enable Phoenix monitoring
USE_PHOENIX=False
# Optional error tracking
SENTRY_DSN=
IS_BIBLIOGRAPHY_ENABLED=True
IS_WEBSEARCH_ENABLED=True


# Azure Blob Storage settings
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_LOCATION=
# Optional configurations (not needed when using connection string)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_AUTO_CREATE_CONTAINER=False
AZURE_STORAGE_DOMAIN_SUFFIX=blob.core.windows.net


# AWS/S3 settings (deprecated)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# AWS_STORAGE_BUCKET=
# AWS_STORAGE_REGION=
AWS_SES_REGION_NAME=
AWS_SES_REGION_ENDPOINT=

# Precious3GPTReverseAgingTool settings
HUGGINFACE_API=
HUGGINFACE_AUTHORIZATION_TOKEN=

# Set True in Production
SESSION_COOKIE_SECURE=False
