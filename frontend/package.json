{
  "name": "dora-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.14.0",
  "browserslist": [
    "defaults",
    "last 2 versions",
    "> 1%",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/system": "^7.2.0",
    "@mui/x-charts": "^8.8.0",
    "@mui/x-tree-view": "^7.3.1",
    "@react-oauth/google": "^0.12.1",
    "@sentry/react": "^10.0.0",
    "@tiptap/core": "^2.3.2",
    "@tiptap/extension-blockquote": "^2.4.0",
    "@tiptap/extension-bullet-list": "^2.4.0",
    "@tiptap/extension-color": "^2.3.2",
    "@tiptap/extension-heading": "^2.4.0",
    "@tiptap/extension-highlight": "^2.4.0",
    "@tiptap/extension-link": "^2.4.0",
    "@tiptap/extension-list-item": "^2.4.0",
    "@tiptap/extension-ordered-list": "^2.4.0",
    "@tiptap/extension-paragraph": "^2.3.2",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-text-align": "^2.3.2",
    "@tiptap/extension-text-style": "^2.3.2",
    "@tiptap/extension-underline": "^2.3.2",
    "@tiptap/pm": "^2.3.2",
    "@tiptap/react": "^2.3.2",
    "@tiptap/starter-kit": "^2.3.2",
    "ahooks": "^3.8.1",
    "axios": "^1.4.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "markdown-it": "^14.1.0",
    "notistack": "^3.0.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.2",
    "prosemirror-state": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "^7.7.1",
    "remark-gfm": "^4.0.1",
    "web-vitals": "^3.5.2",
    "websocket": "^1.0.35",
    "zustand": "^5.0.7"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:analyze": "vite build && echo 'Bundle analysis report generated at bundle-analysis.html'",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json}\" --config ./.prettierrc",
    "prettier": "prettier --check '**/**/*.{js,jsx,ts,tsx,css}'",
    "prettier:fix": "prettier --write '**/**/*.{js,jsx,ts,tsx,css}'",
    "prepare": "husky",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org insilico-medicine --project dora-frontend ./ && sentry-cli sourcemaps upload ./build/static/js --url-prefix '~/static/js' --validate --org insilico-medicine --project dora-frontend ./",
    "clean:sourcemaps": "find ./build/static/js -name '*.map' -type f -delete"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "pnpm lint --fix",
      "pnpm prettier --write"
    ]
  },
  "devDependencies": {
    "@sentry/cli": "^2.50.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.3.0",
    "husky": "^9.1.6",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.11",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4"
  }
}
